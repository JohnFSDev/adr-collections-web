---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";
---

<Layout title="ADR Collections - Muebles y Decoración de Alta Calidad">
  <Header />

  <main>
    <!-- Hero Section Mejorado -->
    <section
      class="bg-gradient-to-b from-[#1e3951] to-[#16334a] text-white py-20 md:py-32 transition-opacity duration-1000 ease-in relative overflow-hidden"
    >
      <!-- Patrón de fondo decorativo -->
      <div class="absolute inset-0 opacity-5">
        <div
          class="absolute inset-0"
          style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
        >
        </div>
      </div>

      <div
        class="container mx-auto px-6 md:px-14 grid grid-cols-1 md:grid-cols-2 gap-8 items-center relative"
      >
        <!-- Columna 1: Información de bienvenida -->
        <div class="text-center md:text-left animate-fadeIn">
          <img
            src="images/logo.webp"
            alt="ADR Collections Logo"
            class="mx-auto mb-8 w-48 md:w-64 md:mx-0 transition-transform duration-500 hover:scale-105"
          />
          <h1
            class="text-4xl md:text-6xl font-bold mb-4 tracking-tight leading-tight"
          >
            Bienvenido a ADR Collections
          </h1>
          <h2 class="text-2xl md:text-3xl mb-6 font-light leading-relaxed">
            Elevando tu hogar con estilo y calidad
          </h2>
          <p
            class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto md:mx-0 leading-relaxed opacity-90"
          >
            Descubre nuestra exclusiva colección de productos de alta calidad
            para transformar tu espacio en un refugio de confort y elegancia.
          </p>
          <div
            class="flex flex-col md:flex-row space-y-4 md:space-y-0 md:space-x-4 mt-6"
          >
            <a
              href="#productos"
              class="group bg-transparent border-2 border-white text-white py-3 px-8 rounded-full text-lg font-semibold hover:bg-white hover:text-[#1e3951] transition-all duration-300 inline-block hover:scale-105 relative overflow-hidden"
            >
              <span class="relative z-10">Ver Productos</span>
              <div
                class="absolute inset-0 bg-white transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"
              >
              </div>
            </a>
            <a
              href="/contacto"
              class="group bg-transparent border-2 border-white text-white py-3 px-8 rounded-full text-lg font-semibold hover:bg-white hover:text-[#1e3951] transition-all duration-300 inline-block hover:scale-105 relative overflow-hidden"
            >
              <span class="relative z-10">Contáctanos</span>
              <div
                class="absolute inset-0 bg-white transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left"
              >
              </div>
            </a>
          </div>
        </div>

        <!-- Columna 2: Video de YouTube optimizado -->
        <div class="flex flex-col items-center w-full max-w-3xl mx-auto">
          <h3 class="text-2xl font-semibold mb-4 text-center">
            ¡Descubre todo lo que tenemos disponible para ti!
          </h3>
          <div
            class="w-full aspect-video rounded-lg overflow-hidden shadow-lg border border-white/20 transform hover:scale-[1.02] transition-all duration-300"
          >
            <YouTube
              id="LP-hiOHVbKE"
              poster="https://img.youtube.com/vi/LP-hiOHVbKE/maxresdefault.jpg"
              class="w-full h-full rounded-lg"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Nueva Sección: Características Destacadas -->
    <section class="bg-[#1a3346] py-16">
      <div class="container mx-auto px-14">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Calidad -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white text-center transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Calidad Premium</h3>
            <p>
              Productos seleccionados cuidadosamente para garantizar la mejor
              calidad.
            </p>
          </div>

          <!-- Envío -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white text-center transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Entrega Segura</h3>
            <p>Entrega cuidadosa y protegida de todos tus productos.</p>
          </div>

          <!-- Atención -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white text-center transform hover:scale-105 transition-all duration-300"
          >
            <div
              class="w-16 h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Atención Personalizada</h3>
            <p>
              Asesoramiento experto para ayudarte a encontrar lo que buscas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ProductShowcase Component -->
    <!-- VERIFICAR PORQUÉ CLIENT LOAD CAUSA ERROR AL HACER BUILD -->
    <ProductShowcase />

    <!-- Nueva Sección: Testimonios -->
    <section class="bg-[#16334a] py-16">
      <div class="container mx-auto px-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
          Lo que dicen nuestros clientes
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Testimonio 1 -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white relative"
          >
            <div class="absolute -top-4 right-4 text-6xl text-white/20">"</div>
            <p class="mb-4 relative z-10">
              Me encantó el termo que adquirí, la calidad está genial, seguiré
              comprando más cosas que me gustaron.
            </p>
            <div class="flex items-center">
              <img
                src="images/angello.webp"
                alt="Angello Gustav Ram"
                class="w-12 h-12 rounded-full object-cover mr-4"
              />
              <div>
                <h4 class="font-semibold">Angello Gustav Ram</h4>
                <p class="text-sm text-white/70">Cliente Verificado</p>
              </div>
            </div>
          </div>

          <!-- Testimonio 2 -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white relative"
          >
            <div class="absolute -top-4 right-4 text-6xl text-white/20">"</div>
            <p class="mb-4 relative z-10">
              Excelente calidad y servicio, además que su servicio a domicilio
              me facilito más mi compra. Están muy bonitos los duos que compre,
              me encantaron!
            </p>
            <div class="flex items-center">
              <img
                src="images/carolina.webp"
                alt="Carolina Estrada"
                class="w-12 h-12 rounded-full object-cover mr-4"
              />
              <div>
                <h4 class="font-semibold">Carolina Estrada</h4>
                <p class="text-sm text-white/70">Cliente Verificado</p>
              </div>
            </div>
          </div>

          <!-- Testimonio 3 -->
          <div
            class="bg-white/5 backdrop-blur-sm p-8 rounded-lg text-white relative"
          >
            <div class="absolute -top-4 right-4 text-6xl text-white/20">"</div>
            <p class="mb-4 relative z-10">
              Recomendar la compra con ellos, siempre atentos. Confiables y los
              productos de buena calidad. Mi vaso me encanto.
            </p>
            <div class="flex items-center">
              <img
                src="images/ireri.webp"
                alt="Ireri Perez"
                class="w-12 h-12 rounded-full object-cover mr-4"
              />
              <div>
                <h4 class="font-semibold">Ireri Perez</h4>
                <p class="text-sm text-white/70">Cliente Verificado</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Visita con Iconos Mejorados -->
    <section id="visit" class="py-16 bg-[#1a3346] text-white">
      <div class="container mx-auto px-6 md:px-12">
        <h2 class="text-4xl font-bold mb-10">Visítanos en nuestra tienda</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <!-- Columna izquierda: Información de contacto -->
          <div class="flex flex-col items-start space-y-8">
            <!-- Ubicación -->
            <div class="flex items-center w-full group">
              <div
                class="shrink-0 w-14 h-14 md:w-16 md:h-16 bg-white/10 rounded-full flex items-center justify-center mr-4 md:mr-6"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 384 512"
                  class="w-6 h-6 md:w-8 md:h-8 text-white"
                >
                  <path
                    d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"
                    fill="currentColor"></path>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-1">Dirección</h3>
                <p class="text-base md:text-xl">
                  Puerto Tampico # 64 Col. Casas Alemán
                </p>
              </div>
            </div>

            <!-- Horario -->
            <div class="flex items-center w-full group">
              <div
                class="shrink-0 w-14 h-14 md:w-16 md:h-16 bg-white/10 rounded-full flex items-center justify-center mr-4 md:mr-6"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 448 512"
                  class="w-6 h-6 md:w-8 md:h-8 text-white"
                >
                  <path
                    fill="currentColor"
                    d="M152 24c0-13.3-10.7-24-24-24s-24 10.7-24 24l0 40L64 64C28.7 64 0 92.7 0 128l0 16 0 48L0 448c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-256 0-48 0-16c0-35.3-28.7-64-64-64l-40 0l0-40c0-13.3-10.7-24-24-24s-24 10.7-24 24l0 40L152 64l0-40zM48 192l352 0 0 256c0 8.8-7.2 16-16 16L64 464c-8.8 0-16-7.2-16-16l0-256z"
                  ></path>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-1">Horario de Atención</h3>
                <p class="text-base md:text-xl">
                  Lunes a Viernes, 10:00 AM - 8:00 PM
                </p>
              </div>
            </div>

            <!-- Teléfono -->
            <a
              href="tel:+525560996032"
              class="flex items-center w-full group transition-transform hover:scale-105"
            >
              <div
                class="shrink-0 w-14 h-14 md:w-16 md:h-16 bg-white/10 rounded-full flex items-center justify-center mr-4 md:mr-6 group-hover:bg-green-600/20"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 512 512"
                  class="w-6 h-6 md:w-8 md:h-8 text-white"
                >
                  <path
                    fill="currentColor"
                    d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"
                  ></path>
                </svg>
              </div>
              <div class="flex-1">
                <h3
                  class="font-semibold text-lg mb-1 group-hover:text-green-400"
                >
                  Teléfono
                </h3>
                <p class="text-base md:text-xl group-hover:text-green-400">
                  +52 55 6099 6032
                </p>
              </div>
            </a>

            <!-- Botón de WhatsApp -->
            <a
              href="https://wa.me/525560996032"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-3 bg-green-600 hover:bg-green-700 text-white py-4 px-8 rounded-full text-lg font-semibold transition-all duration-300 hover:scale-105"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path>
              </svg>
              <span>Contáctanos por WhatsApp</span>
            </a>
          </div>

          <!-- Columna derecha: Mapa -->
          <div
            class="w-full h-96 rounded-lg overflow-hidden shadow-lg transition-transform duration-300 hover:scale-[1.02]"
          >
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3763.387203446149!2d-99.07114568468239!3d19.497267886848215!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d1fba9b5ae7a25%3A0x75e23e6eb2ef6d30!2sPto.%20Tampico%2064%2C%20Casas%20Alem%C3%A1n%2C%20Gustavo%20A.%20Madero%2C%2007580%20Ciudad%20de%20M%C3%A9xico%2C%20CDMX%2C%20M%C3%A9xico!5e0!3m2!1ses!2sdo!4v1695481087929!5m2!1ses!2sdo"
              class="w-full h-full border-none"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              aria-hidden="false"
              title="Ubicación de ADR Collections en Google Maps"
            >
            </iframe>
          </div>
        </div>
      </div>
    </section>

    <Footer />

    <style>
      /* Aspect ratio para video */
      .aspect-video {
        aspect-ratio: 16 / 9;
      }

      @media (max-width: 768px) {
        .max-w-3xl {
          max-width: calc(100% - 2rem);
          margin: 0 auto;
        }
      }

      /* Animaciones de fade in */
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .animate-fadeIn {
        animation: fadeIn 1s ease-out forwards;
      }

      [data-animate] {
        opacity: 0;
        transform: translateY(20px);
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
        transition: all 0.6s ease-out;
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Animación de scroll suave
        const smoothScrollLinks =
          document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
        if (smoothScrollLinks) {
          smoothScrollLinks.forEach((anchor) => {
            anchor.addEventListener("click", function (event: Event) {
              event.preventDefault();
              const targetId = this.getAttribute("href");
              if (targetId) {
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                  targetElement.scrollIntoView({
                    behavior: "smooth",
                    block: "start",
                  });
                }
              }
            });
          });
        }

        // Configuración del Intersection Observer para animaciones
        const setupAnimations = () => {
          const animateElements =
            document.querySelectorAll<HTMLElement>("[data-animate]");
          if (animateElements.length > 0) {
            const observerOptions = {
              root: null,
              rootMargin: "0px",
              threshold: 0.1,
            };

            const animationObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  animationObserver.unobserve(entry.target);
                }
              });
            }, observerOptions);

            animateElements.forEach((element) =>
              animationObserver.observe(element)
            );
          }
        };

        // Iniciar animaciones
        setupAnimations();
      });
    </script>
  </main>
</Layout>
