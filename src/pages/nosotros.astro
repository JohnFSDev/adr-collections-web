---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Sobre Nosotros - ADR Collections">
  <Header />

  <main>
   <!-- Hero Section Mejorado -->
<section
class="bg-gradient-to-b from-[#1e3951] to-[#16334a] text-white py-20 md:py-32 transition-opacity duration-1000 ease-in relative overflow-hidden"
>
<!-- Patrón de fondo decorativo -->
<div class="absolute inset-0 opacity-5">
  <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');">
  </div>
</div>

<div class="container mx-auto px-6 md:px-14 relative z-10">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <!-- Columna de texto -->
    <div class="text-center md:text-left space-y-6 md:pr-12">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
        Sobre <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-white">ADR Collections</span>
      </h1>
      <p class="text-xl leading-relaxed text-gray-300">
        En ADR Collections, nos enorgullece ofrecer productos de alta calidad y acabados exquisitos. Nuestra selección incluye:
      </p>
      <ul class="list-disc ml-5 text-gray-300">
        <li>Bolsos y carteras de diseño elegante y duradero</li>
        <li>Tazas, termos y piezas de vajilla con acabados personalizados</li>
        <li>Artículos decorativos para el hogar, desde adornos hasta textiles</li>
      </ul>
      <p class="text-xl leading-relaxed text-gray-300">
        Nos dedicamos a transformar espacios con productos de diseño excepcional, creando ambientes que inspiren y perduren.
      </p>      
      <div class="grid grid-cols-2 gap-6 mt-8 text-center">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
          <h3 class="text-2xl md:text-3xl font-bold text-blue-300">1+</h3>
          <p class="text-sm text-gray-300">Años de experiencia</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
          <h3 class="text-2xl md:text-3xl font-bold text-blue-300">100+</h3>
          <p class="text-sm text-gray-300">Clientes satisfechos</p>
        </div>
      </div>
    </div>

    <!-- Columna de imagen -->
    <div class="flex justify-center items-center relative">
      <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 rounded-full blur-3xl"></div>
      <img
        src="/images/logo.webp"
        alt="ADR Collections Logo"
        class="w-48 md:w-64 relative z-10 transition-all duration-500 hover:scale-105 drop-shadow-2xl"
      />
      <!-- Elementos decorativos -->
      <div class="absolute top-0 right-0 w-20 h-20 bg-blue-500/20 rounded-full blur-xl"></div>
      <div class="absolute bottom-0 left-0 w-16 h-16 bg-purple-500/20 rounded-full blur-xl"></div>
    </div>
  </div>
</div>
</section>


    <!-- Valores Section -->
    <section class="bg-[#1a3346] py-20">
      <div class="container mx-auto px-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-16">
          Nuestros Valores
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Calidad -->
          <div
            class="bg-white/10 p-8 rounded-lg backdrop-blur-sm text-white text-center"
          >
            <div
              class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-4">Calidad Superior</h3>
            <p class="leading-relaxed">
              Seleccionamos cuidadosamente cada producto para garantizar la más
              alta calidad.
            </p>
          </div>

          <!-- Servicio -->
          <div
            class="bg-white/10 p-8 rounded-lg backdrop-blur-sm text-white text-center"
          >
            <div
              class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-4">Atención Personalizada</h3>
            <p class="leading-relaxed">
              Nos dedicamos a entender y satisfacer las necesidades únicas de
              cada cliente.
            </p>
          </div>

          <!-- Innovación -->
          <div
            class="bg-white/10 p-8 rounded-lg backdrop-blur-sm text-white text-center"
          >
            <div
              class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-4">Innovación Constante</h3>
            <p class="leading-relaxed">
              Buscamos continuamente nuevas tendencias y productos para nuestros
              clientes.
            </p>
          </div>

          <!-- Compromiso -->
          <div
            class="bg-white/10 p-8 rounded-lg backdrop-blur-sm text-white text-center"
          >
            <div
              class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-full flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-4">Compromiso Social</h3>
            <p class="leading-relaxed">
              Trabajamos con proveedores locales y promovemos prácticas
              sustentables.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-[#16334a] py-16">
      <div class="container mx-auto px-14 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-8">
          ¿Listo para transformar tu espacio?
        </h2>
        <div class="flex flex-col md:flex-row justify-center gap-4">
          <a
            href="/#productos"
            class="bg-transparent border-2 border-white text-white py-3 px-8 rounded-full text-lg font-semibold hover:bg-white hover:text-[#1e3951] transition-all duration-300 hover:scale-105 inline-block"
          >
            Ver Productos
          </a>
          <a
            href="/contacto"
            class="bg-transparent border-2 border-white text-white py-3 px-8 rounded-full text-lg font-semibold hover:bg-white hover:text-[#1e3951] transition-all duration-300 hover:scale-105 inline-block"
          >
            Contáctanos
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
